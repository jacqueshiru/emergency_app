# Copy to frontend/.env.android and set your real backend URL (https, no trailing slash).
# The Android app cannot use localhost: it must reach your hosted backend (or an https tunnel).
VITE_API_URL=https://your-backend.example.com

# While testing with real people: marks every SOS text "TEST ONLY - NOT A REAL EMERGENCY". Remove for real use.
VITE_TEST_MODE=true
