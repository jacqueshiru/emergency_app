PORT=5000
NODE_ENV=development
# Neon or Local PostgreSQL connection URL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/seas?schema=public"

# Auth Secrets
JWT_SECRET="seas_access_secret_production_ready_dev_key_2026"
JWT_REFRESH_SECRET="seas_refresh_secret_production_ready_dev_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Africa's Talking Credentials (Sandbox by default)
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID=""

# Alert Configuration
STALE_ALERT_THRESHOLD_MINUTES=10
# For the Android app also allow its WebView origin:  "https://your-web-origin,https://localhost"
CORS_ORIGIN="http://localhost:5173"

# Webhook authentication (REQUIRED; the delivery webhook fails closed without it).
# Configure Africa's Talking callback as:  https://<host>/webhooks/africastalking/delivery?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET="change-me-long-random-string"

# --- SMS provider -----------------------------------------------------------
# "africastalking" (default) or "gateway" = your own Android phone running the
# "SMS Gateway for Android" app (github.com/capcom6/android-sms-gateway).
SMS_PROVIDER="gateway"   # gateway | africastalking | mock (mock = simulate, nothing is sent; only for automated tests)
# Local mode (phone on the same Wi-Fi): http://<phone-ip-shown-in-app>:8080
# Cloud mode: https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_URL=""
SMS_GATEWAY_USERNAME=""
SMS_GATEWAY_PASSWORD=""

# --- Security settings ------------------------------------------------------
# Your real frontend origin(s), comma separated. Required in production (never "*").
# For the Android app also allow its WebView origin:  "https://your-web-origin,https://localhost"
CORS_ORIGIN="http://localhost:5173"
# Local development ONLY, and only while no real SMS provider is configured:
# returns the OTP in the API response / console so you can log in without SMS.
# Ignored automatically when SMS_PROVIDER=gateway or AT_API_KEY is set. Never enable in production.
# ALLOW_DEV_OTP="true"
# Behind a reverse proxy (Render, Nginx, ...): number of proxies, so rate limits see real client IPs.
# TRUST_PROXY="1"
# Max emergency contacts per user (each SOS texts every contact).
# MAX_CONTACTS_PER_USER="10"
# Android WebView origins (https://localhost, capacitor://localhost) are added to CORS automatically.
# ALLOW_NATIVE_APP_ORIGINS="false"
